SERIAL0_BAUD 115
SERIAL0_PROTOCOL 2

# setup SERIAL1 for Fire_FIGHT
SERIAL1_BAUD 115
SERIAL1_PROTOCOL 5

# setup SERIAL2 for MOTOR
SERIAL2_BAUD 115
SERIAL2_PROTOCOL -1

# setup SERIAL3 for RCIN
SERIAL3_BAUD 115
SERIAL3_PROTOCOL 23

# setup SERIAL4 for RCIN
SERIAL4_BAUD 115
SERIAL4_PROTOCOL 42

# setup SERIAL5 for RCIN
SERIAL5_BAUD 921
SERIAL5_PROTOCOL 45

# setup SERIAL6 for RCIN
SERIAL6_BAUD 115
SERIAL6_PROTOCOL -1

# setup SERIAL7 for RCIN
SERIAL7_BAUD 115
SERIAL7_PROTOCOL 2


# setup ARMING_CHECK
ARMING_CHECK 0

# setup RC7_chane
RC5_OPTION 153

# setup MODE_CH
MODE_CH 6
MODE6 10

# setup RC2_chane
RC2_REVERSED 1
# setup RC3_chane
RC3_REVERSED 0
# setup to WP_SAVE
RC7_OPTION 7
RC8_OPTION 58

# setup hands
RCMAP_PITCH 4
RCMAP_ROLL 1
RCMAP_THROTTLE 2
RCMAP_YAW 3

# SERVO_FUNCTION config
SERVO1_FUNCTION 73
SERVO2_FUNCTION 74
SERVO3_FUNCTION 63
SERVO1_REVERSED 1
SERVO3_REVERSED 0
SERVO2_REVERSED 1

# BATT_VILT_MULT
BATT_MONITOR 3
BATT_VOLT_MULT 21.17
		
# control motor rev
MOT_SLEWRATE 0

ATC_STR_ACC_MAX 180
ATC_STR_ANG_P 10
ATC_STR_RAT_MAX 180
ATC_STR_RAT_P 0.4

PSC_POS_P 1
PSC_VEL_D 0.15
PSC_VEL_FF 0.1
PSC_VEL_I 1
PSC_VEL_P 2.5

# EKF3 config
EK3_SRC1_YAW 2

# GPS config as NMEA
GPS1_TYPE 25
GPS_AUTO_CONFIG 0
GPS1_MB_TYPE 1
GPS1_MB_OFS_Y -0.43
GPS1_POS_X -0.44
GPS1_POS_Y -0.22
GPS1_POS_Z -0.35

SCR_ENABLE 0

# enable CAN_PROTOCOL
CAN_D1_PROTOCOL 1
CAN_P1_DRIVER 1
CAN_D1_UC_SRV_BM 5

# enable PRX
PRX1_TYPE 15
PRX1_ADDR 1
PRX2_TYPE 15
PRX2_ADDR 2
PRX3_TYPE 15
PRX3_ADDR 3

# enable tofsense
TOFSENSE_ID1 1
TOFSENSE_ID2 2
TOFSENSE_ID3 3

TOFSENSE_INS1 1
TOFSENSE_INS2 2
TOFSENSE_INS3 3

TOFSENSE_MODE 0

OSD_TYPE 0

CAN_P1_BITRATE 500000

BRD_SER1_RTSCTS 1

DDS_ENABLE 1

ATC_BRAKE 0


