# setup SERIAL1 for Fire_FIGHT
SERIAL1_BAUD 256
SERIAL1_PROTOCOL 42

# setup SERIAL2 for MOTOR
# SERIAL2_BAUD 57
# SERIAL2_PROTOCOL -1

# setup SERIAL3 for RCIN
SERIAL3_BAUD 57
SERIAL3_PROTOCOL 23

# setup SERIAL5 for RCIN
SERIAL5_BAUD 115
SERIAL5_PROTOCOL 2

# setup SERIAL6 for GPS
SERIAL6_BAUD 115
SERIAL6_PROTOCOL 5

# setup MODE
MODE_CH 6
MODE1 10
MODE4 3

# setup EK3
EK3_IMU_MASK 1
EK3_SRC1_YAW 2

# setup GPS
GPS_RATE_MS 50
GPS_TYPE 5


# setup ARMING_CHECK
ARMING_CHECK 0

# setup RC7_chane
RC6_OPTION 153
RC7_OPTION 16
RC11_OPTION 51

# setup MODE_CH


# setup RC2_chane
RC2_REVERSED 1
# setup RC3_chane
RC3_REVERSED 0


# setup hands
RCMAP_THROTTLE 2
RCMAP_PITCH 3

# SERVO_FUNCTION config
SERVO1_FUNCTION 73
SERVO3_FUNCTION 74
SERVO1_REVERSED 1
SERVO3_REVERSED 1



# BATT_VILT_MULT
BATT_VOLT_MULT 40.8
BATT_MONITOR 3



ATC_STR_ACC_MAX 60
ATC_STR_RAT_MAX 60
ATC_STR_RAT_P 0.15
ATC_STR_RAT_FF 0.83
ATC_STR_RAT_FLTD 2
ATC_STR_RAT_FLTT 2
ATC_STR_RAT_P 0.25
ATC_SPEED_P 0.15
ATC_SPEED_I 0.08


# navig parm
PSC_POS_P 0.3
PSC_VEL_D 0.2
PSC_VEL_I 0.54
PSC_VEL_P 2.7

#  wp_parm
TURN_RADIUS 0
WP_RADIUS 0.6
WP_SPEED 2
WP_PIVOT_ANGLE 0





#Below are the configurations needed for CAN communication.
#This is the script enable button.
SCR_ENABLE  1 
#this is the script flash capacity
SCR_HEAP_SIZE 102400
#This is the script command for using CAN1
CAN_D1_PROTOCOL 10 
#this is choose the frist drives
CAN_P1_DRIVER 1  
#Select the baud rate to 250K.
CAN_P1_BITRATE 250000

MOT_SLEWRATE 95

